>
  <main>
    <HeroLP3 />
    <Manifesto />
    <Numeros />
    <Historias />
    <Beneficios />
    <Eventos />
    <CompartilheHistoria />
    <CTALP3 />
  </main>
  <Footer />
</Layout>
