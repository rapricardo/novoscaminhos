---
import Layout from '../layouts/Layout.astro';
import HeroLP3 from '../components/lp3/HeroLP3.astro';
import Manifesto from '../components/lp3/Manifesto.astro';
import Numeros from '../components/lp3/Numeros.astro';
import Historias from '../components/lp3/Historias.astro';
import Beneficios from '../components/lp3/Beneficios.astro';
import Eventos from '../components/lp3/Eventos.astro';
import CompartilheHistoria from '../components/lp3/CompartilheHistoria.astro';
import CTALP3 from '../components/lp3/CTALP3.astro';
import Footer from '../components/Footer.astro';
---

<Layout 
  title="Comunidade | Associação Novos Caminhos" 
  page="lp3"
