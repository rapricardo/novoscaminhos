---
import Navbar from '../components/Navbar';
import '../styles/global.css';

interface Props {
  title: string;
  page?: 'home' | 'lp1' | 'lp2' | 'lp3';
  description?: string;
}

const { title, page = 'home', description = 'Associação Novos Caminhos - Acesso legal e seguro a terapias integrativas de grau farmacêutico com acolhimento humano.' } = Astro.props;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Playfair+Display:ital,wght@0,600;1,600&display=swap" rel="stylesheet" />
    <title>{title}</title>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-QDP9QM9HHT"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-QDP9QM9HHT');
      gtag('config', 'AW-16836757969');
    </script>
    <!-- Event snippet for whatsapp conversion -->
    <script is:inline>
      function gtag_report_conversion(url) {
        var callback = function () {
          if (typeof(url) != 'undefined') {
            window.location = url;
          }
        };
        gtag('event', 'conversion', {
          'send_to': 'AW-16836757969/8l3MCMGoo7MbENGTstw-',
          'event_callback': callback
        });
        return false;
      }

      // Intercepta todos os cliques em links do WhatsApp
      document.addEventListener('DOMContentLoaded', function() {
        document.querySelectorAll('a[href*="wa.me"]').forEach(function(link) {
          link.addEventListener('click', function(e) {
            e.preventDefault();
            var href = this.href;
            var target = this.target;
            
            gtag('event', 'conversion', {
              'send_to': 'AW-16836757969/8l3MCMGoo7MbENGTstw-',
              'event_callback': function() {
                if (target === '_blank') {
                  window.open(href, '_blank');
                } else {
                  window.location.href = href;
                }
              }
            });
            
            // Fallback: se o callback não executar em 1s, abre mesmo assim
            setTimeout(function() {
              if (target === '_blank') {
                window.open(href, '_blank');
              } else {
                window.location.href = href;
              }
            }, 1000);
          });
        });
      });
    </script>
  </head>
  <body class="min-h-screen bg-brand-sand font-sans text-gray-900 selection:bg-brand-green selection:text-white">
    <Navbar client:load page={page} />
    <slot />
  </body>
</html>
