---
// Steps Section - Static Astro Component

const steps = [
  {
    title: "1. Cadastro Simples",
    desc: "Entre em contato conosco pelo WhatsApp para iniciar seu acolhimento.",
    icon: "user-plus"
  },
  {
    title: "2. Consulta Médica",
    desc: "Agendamos uma consulta com médicos prescritores especialistas em terapia integrativa.",
    icon: "stethoscope"
  },
  {
    title: "3. Autorização Legal",
    desc: "Nossa equipe jurídica cuida de toda a documentação necessária (Anvisa/Salvo Conduto).",
    icon: "file-check"
  },
  {
    title: "4. Início do Tratamento",
    desc: "Você recebe o acolhimento contínuo e monitoramento da sua evolução.",
    icon: "heart"
  }
];
---

<section class="py-32 bg-white">
  <div class="max-w-6xl mx-auto px-6">
    <div class="text-center mb-20">
      <h2 class="text-3xl lg:text-4xl font-serif text-gray-900 mb-4">Como Funciona a Jornada</h2>
      <p class="text-gray-500 max-w-xl mx-auto">Simplificamos a burocracia para que você foque apenas na sua recuperação.</p>
    </div>

    <div class="relative">
      <!-- Connecting Line (Desktop) -->
      <div class="hidden md:block absolute top-12 left-0 w-full h-0.5 bg-gray-100 z-0"></div>

      <div class="grid grid-cols-1 md:grid-cols-4 gap-12 relative z-10">
        {steps.map((step) => (
          <div class="flex flex-col items-center text-center group">
            <div class="w-24 h-24 bg-white border-4 border-gray-50 rounded-full flex items-center justify-center mb-6 shadow-sm group-hover:border-brand-green/30 transition-colors duration-300">
              {step.icon === "user-plus" && (
                <svg xmlns="http://www.w3.org/2000/svg" class="text-brand-green w-10 h-10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
                  <circle cx="9" cy="7" r="4" />
                  <line x1="19" x2="19" y1="8" y2="14" />
                  <line x1="22" x2="16" y1="11" y2="11" />
                </svg>
              )}
              {step.icon === "stethoscope" && (
                <svg xmlns="http://www.w3.org/2000/svg" class="text-brand-green w-10 h-10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M4.8 2.3A.3.3 0 1 0 5 2H4a2 2 0 0 0-2 2v5a6 6 0 0 0 6 6v0a6 6 0 0 0 6-6V4a2 2 0 0 0-2-2h-1a.2.2 0 1 0 .3.3" />
                  <path d="M8 15v1a6 6 0 0 0 6 6v0a6 6 0 0 0 6-6v-4" />
                  <circle cx="20" cy="10" r="2" />
                </svg>
              )}
              {step.icon === "file-check" && (
                <svg xmlns="http://www.w3.org/2000/svg" class="text-brand-green w-10 h-10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z" />
                  <path d="M14 2v4a2 2 0 0 0 2 2h4" />
                  <path d="m9 15 2 2 4-4" />
                </svg>
              )}
              {step.icon === "heart" && (
                <svg xmlns="http://www.w3.org/2000/svg" class="text-brand-green w-10 h-10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z" />
                </svg>
              )}
            </div>
            <h3 class="text-xl font-medium text-gray-900 mb-3">{step.title}</h3>
            <p class="text-sm text-gray-500 leading-relaxed px-4">
              {step.desc}
            </p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
