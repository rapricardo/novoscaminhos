---
/**
 * Benefícios LP3 - Clube de Benefícios
 */

const benefits = [
  {
    icon: 'access',
    title: 'Acesso Facilitado',
    text: 'Rede de médicos prescritores parceiros com valores acessíveis para associados.'
  },
  {
    icon: 'legal',
    title: 'Assessoria Jurídica Gratuita',
    text: 'Cuidamos de todo o processo de autorização na ANVISA para você.'
  },
  {
    icon: 'support',
    title: 'Grupos de Apoio',
    text: 'Troca de experiências e suporte emocional com quem vive desafios parecidos com os seus.'
  },
  {
    icon: 'education',
    title: 'Educação Contínua',
    text: 'Acesso a webinars, palestras e conteúdos exclusivos sobre saúde integrativa.'
  }
];
---

<section id="beneficios" class="py-32 bg-white">
  <div class="max-w-6xl mx-auto px-6">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
      
      <!-- Content -->
      <div>
        <h2 class="text-3xl lg:text-4xl font-serif text-gray-900 mb-8">
          Por que fazer parte da <span class="text-[#005742]">Novos Caminhos</span>?
        </h2>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          {benefits.map((benefit) => (
            <div class="flex items-start gap-4">
              <div class="flex-shrink-0 w-12 h-12 rounded-full bg-[#CED994]/30 flex items-center justify-center">
                {benefit.icon === 'access' && (
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#005742" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4" />
                    <polyline points="10 17 15 12 10 7" />
                    <line x1="15" y1="12" x2="3" y2="12" />
                  </svg>
                )}
                {benefit.icon === 'legal' && (
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#005742" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2" />
                    <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                  </svg>
                )}
                {benefit.icon === 'support' && (
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#005742" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                    <circle cx="9" cy="7" r="4" />
                    <path d="M23 21v-2a4 4 0 0 0-3-3.87" />
                    <path d="M16 3.13a4 4 0 0 1 0 7.75" />
                  </svg>
                )}
                {benefit.icon === 'education' && (
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#005742" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z" />
                    <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z" />
                  </svg>
                )}
              </div>
              <div>
                <h4 class="font-medium text-gray-900 mb-1">{benefit.title}</h4>
                <p class="text-gray-600 text-sm">{benefit.text}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Image -->
      <div class="relative">
        <div class="rounded-2xl overflow-hidden shadow-xl">
          <img 
            src="/images/lp3-benefits.webp" 
            alt="Roda de conversa - grupo de apoio"
            class="w-full h-auto object-cover"
          />
        </div>
      </div>
    </div>
  </div>
</section>
