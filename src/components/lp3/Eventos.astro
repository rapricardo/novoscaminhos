---
/**
 * Eventos LP3 - Agenda
 */

const events = [
  {
    type: 'Webinar',
    title: '"Entendendo a Terapia Integrativa" - Com Dr. Especialista'
  },
  {
    type: 'Encontro Online',
    title: 'Roda de Acolhimento para Mães Atípicas'
  }
];
---

<section id="eventos" class="py-32" style="background-color: rgba(206, 217, 148, 0.1);">
  <div class="max-w-6xl mx-auto px-6">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
      
      <!-- Image -->
      <div class="relative order-2 lg:order-1">
        <div class="rounded-2xl overflow-hidden shadow-xl">
          <img 
            src="/images/lp3-event.webp" 
            alt="Palestra ou webinar educacional"
            class="w-full h-auto object-cover"
          />
        </div>
      </div>

      <!-- Content -->
      <div class="order-1 lg:order-2">
        <h2 class="text-3xl lg:text-4xl font-serif text-gray-900 mb-8">
          Acompanhe nossa <span class="text-[#005742]">agenda</span>
        </h2>

        <div class="space-y-4 mb-8">
          {events.map((event) => (
            <div class="bg-white p-6 rounded-xl shadow-sm flex items-start gap-4">
              <div class="flex-shrink-0 px-3 py-1 bg-[#EC8323]/10 text-[#EC8323] text-xs font-semibold rounded-full">
                {event.type}
              </div>
              <p class="text-gray-900 font-medium">{event.title}</p>
            </div>
          ))}
        </div>

        <a
          href="https://wa.me/554891203870?text=Ol%C3%A1!%20Gostaria%20de%20me%20inscrever%20nos%20eventos."
          target="_blank"
          rel="noopener noreferrer"
          onclick="gtag_report_conversion()"
          class="inline-flex items-center gap-2 bg-[#EC8323] text-white font-medium px-8 py-4 rounded-full hover:bg-opacity-90 transition-all shadow-lg"
        >
          Inscrever-se nos eventos
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14" />
            <path d="m12 5 7 7-7 7" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>
