---
/**
 * Jornada LP1 - Como Funciona (4 passos)
 */

const steps = [
  {
    number: '1',
    title: 'Acolhimento',
    desc: 'Entre em contato e receba atendimento humanizado para tirar suas dúvidas iniciais.'
  },
  {
    number: '2',
    title: 'Avaliação Médica',
    desc: 'Agende uma consulta com médicos prescritores experientes em terapias integrativas.'
  },
  {
    number: '3',
    title: 'Autorização Legal',
    desc: 'Nossa equipe jurídica auxilia gratuitamente na emissão da autorização da ANVISA.'
  },
  {
    number: '4',
    title: 'Início do Tratamento',
    desc: 'Receba o produto em casa com segurança e tenha acompanhamento contínuo da nossa equipe.'
  }
];
---

<section id="como-funciona" class="py-32 bg-white">
  <div class="max-w-6xl mx-auto px-6">
    <div class="text-center mb-20">
      <h2 class="text-3xl lg:text-4xl font-serif text-gray-900 mb-4">Sua jornada em 4 passos</h2>
    </div>

    <div class="relative">
      <!-- Connecting Line (Desktop) -->
      <div class="hidden md:block absolute top-16 left-0 w-full h-0.5 bg-gray-100 z-0"></div>

      <div class="grid grid-cols-1 md:grid-cols-4 gap-12 relative z-10">
        {steps.map((step) => (
          <div class="flex flex-col items-center text-center group">
            <div 
              class="w-24 h-24 rounded-full flex items-center justify-center mb-6 shadow-sm border-4 border-white group-hover:scale-105 transition-transform"
              style="background-color: #CED994;"
            >
              <span class="text-2xl font-bold" style="color: #005742;">{step.number}</span>
            </div>
            <h3 class="text-xl font-medium text-gray-900 mb-3">{step.title}</h3>
            <p class="text-sm text-gray-500 leading-relaxed px-4">
              {step.desc}
            </p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
