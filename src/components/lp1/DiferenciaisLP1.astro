---
/**
 * Diferenciais LP1 - Por que escolher a Novos Caminhos?
 */

const benefits = [
  'Fitoativos de grau farmacêutico com análise laboratorial rigorosa',
  'Equipe multidisciplinar (médicos, psicólogos e advogados)',
  'Comunidade de apoio ativa e acolhedora',
  'Atuação 100% legalizada conforme normas vigentes'
];
---

<section class="py-32 bg-white">
  <div class="max-w-6xl mx-auto px-6">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
      
      <!-- Image -->
      <div class="relative">
        <div class="rounded-2xl overflow-hidden shadow-xl">
          <img 
            src="/images/slide-01-oleo-foco.webp" 
            alt="Mãos segurando frasco de óleo âmbar com delicadeza"
            class="w-full h-auto object-cover"
          />
        </div>
      </div>

      <!-- Content -->
      <div>
        <h2 class="text-3xl lg:text-4xl font-serif text-gray-900 mb-8">
          Por que escolher a <span style="color: #005742;">Novos Caminhos</span>?
        </h2>

        <ul class="space-y-6">
          {benefits.map((benefit) => (
            <li class="flex items-start gap-4">
              <div 
                class="flex-shrink-0 w-8 h-8 rounded-full flex items-center justify-center mt-0.5"
                style="background-color: #CED994;"
              >
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#005742" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M20 6 9 17l-5-5" />
                </svg>
              </div>
              <span class="text-gray-700 text-lg">{benefit}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>
