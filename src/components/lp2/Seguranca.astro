---
/**
 * Segurança LP2 - Por que é seguro?
 */

const items = [
  {
    title: 'Autorização ANVISA',
    text: 'Todo o processo segue rigorosamente a RDC 660, com importação autorizada e fiscalizada.'
  },
  {
    title: 'Controle de Qualidade',
    text: 'Produtos com Certificado de Análise (COA) que comprovam pureza e concentração de ativos.'
  },
  {
    title: 'Acolhimento Jurídico',
    text: 'Nossa equipe cuida de toda a burocracia para que você foque apenas na sua recuperação.'
  },
  {
    title: 'Corpo Clínico Especializado',
    text: 'Médicos prescritores com experiência comprovada em terapias integrativas.'
  }
];
---

<section id="seguranca" class="py-32 bg-gray-50">
  <div class="max-w-6xl mx-auto px-6">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
      
      <!-- Content -->
      <div>
        <h2 class="text-3xl lg:text-4xl font-serif text-gray-900 mb-8">
          Segurança <span class="text-[#006581]">Jurídica e Sanitária</span>
        </h2>

        <ul class="space-y-6">
          {items.map((item) => (
            <li class="flex items-start gap-4">
              <div class="flex-shrink-0 w-10 h-10 rounded-full bg-[#006581]/10 flex items-center justify-center mt-0.5">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#006581" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M20 6 9 17l-5-5" />
                </svg>
              </div>
              <div>
                <h4 class="font-medium text-gray-900 mb-1">{item.title}</h4>
                <p class="text-gray-600 text-sm">{item.text}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>

      <!-- Image -->
      <div class="relative">
        <div class="rounded-2xl overflow-hidden shadow-xl">
          <img 
            src="/images/lp2-safety-certificate.webp" 
            alt="Controle de qualidade - frasco com certificado"
            class="w-full h-auto object-cover"
          />
        </div>
      </div>
    </div>
  </div>
</section>
