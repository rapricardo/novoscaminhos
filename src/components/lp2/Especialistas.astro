---
/**
 * Especialistas LP2 - Quem cuida de você
 */

const doctors = [
  {
    name: 'Dr. Ricardo Mendes',
    specialty: 'Neurologia Integrativa',
    bio: 'Acredito na medicina que escuta o paciente antes de tratar a doença.',
    image: '/images/lp2-doctor-1.webp'
  },
  {
    name: 'Dra. Fernanda Costa',
    specialty: 'Clínica da Dor e Cuidados Paliativos',
    bio: 'Nosso foco é devolver a autonomia e o bem-estar diário.',
    image: '/images/lp2-doctor-2.webp'
  }
];
---

<section id="especialistas" class="py-32 bg-white">
  <div class="max-w-6xl mx-auto px-6">
    <div class="text-center mb-16">
      <h2 class="text-3xl lg:text-4xl font-serif text-gray-900 mb-4">Quem cuida de você</h2>
      <p class="text-gray-600">Uma equipe multidisciplinar pronta para acolher.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-4xl mx-auto">
      {doctors.map((doctor) => (
        <div class="bg-gray-50 rounded-2xl p-8 text-center">
          <img 
            src={doctor.image} 
            alt={doctor.name}
            class="w-32 h-32 rounded-full object-cover mx-auto mb-6 shadow-lg"
          />
          <h3 class="text-xl font-medium text-gray-900 mb-1">{doctor.name}</h3>
          <p class="text-[#006581] font-medium text-sm mb-4">{doctor.specialty}</p>
          <p class="text-gray-600 italic">"{doctor.bio}"</p>
        </div>
      ))}
    </div>

    <div class="text-center mt-12">
      <a
        href="https://wa.me/554891203870?text=Ol%C3%A1!%20Gostaria%20de%20agendar%20uma%20consulta%20com%20um%20especialista."
        target="_blank"
        rel="noopener noreferrer"
        onclick="gtag_report_conversion()"
        class="inline-flex items-center gap-2 bg-[#006581] text-white font-medium px-8 py-4 rounded-full hover:bg-opacity-90 transition-all shadow-lg"
      >
        Agendar com Especialista
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 12h14" />
          <path d="m12 5 7 7-7 7" />
        </svg>
      </a>
    </div>
  </div>
</section>
