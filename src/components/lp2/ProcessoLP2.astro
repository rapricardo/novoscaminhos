---
/**
 * Processo LP2 - Timeline horizontal
 */

const steps = [
  {
    number: '1',
    title: 'Triagem e Consulta',
    desc: 'Agende sua avaliação com um médico prescritor parceiro para análise do seu quadro clínico.'
  },
  {
    number: '2',
    title: 'Autorização Sanitária',
    desc: 'Com a receita em mãos, nossa equipe auxilia gratuitamente na emissão da autorização da ANVISA.'
  },
  {
    number: '3',
    title: 'Acesso ao Tratamento',
    desc: 'Orientamos a aquisição do produto prescrito, garantindo origem e segurança.'
  },
  {
    number: '4',
    title: 'Monitoramento',
    desc: 'Acompanhamento periódico para ajuste de dosagem e avaliação da evolução clínica.'
  }
];
---

<section class="py-32 bg-white">
  <div class="max-w-6xl mx-auto px-6">
    <div class="text-center mb-20">
      <h2 class="text-3xl lg:text-4xl font-serif text-gray-900 mb-4">
        Como iniciar seu tratamento <span class="text-[#006581]">legalmente</span>
      </h2>
    </div>

    <div class="relative">
      <!-- Connecting Line (Desktop) -->
      <div class="hidden md:block absolute top-16 left-0 w-full h-0.5 bg-[#006581]/20 z-0"></div>

      <div class="grid grid-cols-1 md:grid-cols-4 gap-12 relative z-10">
        {steps.map((step) => (
          <div class="flex flex-col items-center text-center group">
            <div class="w-24 h-24 bg-[#006581] rounded-full flex items-center justify-center mb-6 shadow-lg group-hover:scale-105 transition-transform">
              <span class="text-2xl font-bold text-white">{step.number}</span>
            </div>
            <h3 class="text-lg font-medium text-gray-900 mb-3">{step.title}</h3>
            <p class="text-sm text-gray-500 leading-relaxed">
              {step.desc}
            </p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
